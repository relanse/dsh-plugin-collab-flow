{
  "name": "@dsh-community/plugin-subagent-cli",
  "description": "通过受管 OpenCode CLI 执行 DSH 单次子 agent 委派",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relanse/dsh-plugin-collab-flow.git",
    "directory": "packages/subagent-cli"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./runs": {
      "types": "./lib/types/runs.d.ts",
      "default": "./lib/runs.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/runs.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint src",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "probe": "pnpm run build && node scripts/probe.mjs",
    "probe:permissions": "pnpm run build && node scripts/check-leaf-permission.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-subagent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-timeout": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.5-rc.2",
    "@types/node": "^22.0.0",
    "oxlint": "1.76.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
